---
import type { FaqItem } from '../content/types';
interface Props { items: FaqItem[]; }
const { items } = Astro.props;
---
<div class="faq-list">
  {items.map((faq) => <details class="faq-item">
    <summary>{faq.question}</summary>
    <p>{faq.answer.map((segment) => segment.href ? <a href={segment.href}>{segment.text}</a> : <>{segment.text}</>)}</p>
  </details>)}
</div>
