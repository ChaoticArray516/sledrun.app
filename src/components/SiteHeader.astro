---
import { site } from '../content/site';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
---
<header class="site-header">
  <a class="brand-link" href="/" aria-label="SledRun">
    <img src="/favicon.svg" alt="" width="30" height="30"><span>SledRun</span>
  </a>
  <details class="site-nav-details">
    <summary aria-label="Open navigation">Menu</summary>
    <nav class="site-nav" aria-label="Games">
      {site.nav.map((item) => <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </details>
</header>
