---
import BaseLayout from '../layouts/BaseLayout.astro';
import GameShell from '../components/GameShell.astro';
import PageContent from '../components/PageContent.astro';
import { sledding } from '../content/3d-sledding';
import { createSchema } from '../content/schema';
---
<BaseLayout title={sledding.title} description={sledding.description} canonical="https://sledrun.app/3d-sledding" schema={createSchema(sledding)}>
  <GameShell mode="sledding" gameName={sledding.gameName} currentPath={sledding.path} />
  <PageContent page={sledding} />
</BaseLayout>
