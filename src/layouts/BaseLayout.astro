---
import SeoHead from '../components/SeoHead.astro';
import JsonLd from '../components/JsonLd.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/tokens.css';
import '../styles/global.css';
interface Props {
  title: string;
  description: string;
  canonical: string;
  schema?: Record<string, unknown>;
  robots?: string;
}
const { title, description, canonical, schema, robots } = Astro.props;
---
<!doctype html>
<html lang="en-US">
  <head><SeoHead {title} {description} {canonical} {robots} />{schema && <JsonLd {schema} />}</head>
  <body><slot /><SiteFooter /></body>
</html>
